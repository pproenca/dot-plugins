{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pstack",
  "version": "0.16.0",
  "description": "if you want to go fast, go deep first. pstack helps you write less, but higher quality code. rigorous agent workflows you can parallelize with confidence.",
  "author": {
    "name": "Lauren Tan"
  },
  "homepage": "https://github.com/cursor/plugins/tree/main/pstack",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "keywords": [
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "pstack",
        "shortDescription": "Rigorous workflows for higher-quality code",
        "longDescription": "Use focused engineering playbooks, principles, and verification workflows to reason deeply, parallelize confidently, and produce less but better code.",
        "developerName": "Lauren Tan",
        "category": "Developer Tools",
        "websiteURL": "https://github.com/cursor/plugins/tree/main/pstack",
        "privacyPolicyURL": "https://github.com/cursor/plugins/tree/main/pstack",
        "termsOfServiceURL": "https://github.com/cursor/plugins/blob/main/LICENSE",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "defaultPrompt": [
          "Make this implementation less sloppy",
          "Design a rigorous verification plan",
          "Teach me the principle behind this code"
        ]
      }
    }
  }
}
